{
  "uid": "vitasignal-overview",
  "title": "VitaSignal",
  "description": "API health and clinical telemetry for the VitaSignal platform.",
  "tags": ["vitasignal"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 41,
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Readings / min",
      "description": "Vital sign readings accepted by the API in the last minute.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(vitasignal_vital_readings_registered_total[1m]))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Critical alerts (1h)",
      "description": "Clinical alerts with Critical severity raised in the last hour.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(vitasignal_alerts_raised_total{severity=\"Critical\"}[1h])) or vector(0)" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx error rate (5m)",
      "description": "Share of API requests answered with a server error. Scrape and health check endpoints are excluded.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\",http_route!~\"/metrics|/health/.*\"}[5m])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{http_route!~\"/metrics|/health/.*\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API scrape target",
      "description": "Whether Prometheus can reach the API metrics endpoint.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "up{job=\"vitasignal-api\"}" }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "API health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput by route",
      "description": "Requests per second per route. Scrape and health check endpoints are excluded.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{http_route!~\"/metrics|/health/.*\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency by route (p95 / p99)",
      "description": "Server-side request duration percentiles per route.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/metrics|/health/.*\"}[$__rate_interval])))",
          "legendFormat": "p95 {{http_request_method}} {{http_route}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/metrics|/health/.*\"}[$__rate_interval])))",
          "legendFormat": "p99 all routes"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "5xx error rate",
      "description": "Share of API requests answered with a server error.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "fillOpacity": 20, "axisSoftMax": 0.1, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\",http_route!~\"/metrics|/health/.*\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{http_route!~\"/metrics|/health/.*\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Responses by status code",
      "description": "Requests per second grouped by HTTP status code.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 30, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{http_route!~\"/metrics|/health/.*\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Clinical telemetry",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Readings per minute by vital sign",
      "description": "Readings accepted per minute, split by vital sign type.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (vital_sign_type) (rate(vitasignal_vital_readings_registered_total[$__rate_interval])) * 60",
          "legendFormat": "{{vital_sign_type}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Out-of-range readings per minute",
      "description": "Readings outside the normal clinical range, split by vital sign type.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (vital_sign_type) (rate(vitasignal_vital_readings_out_of_range_total[$__rate_interval])) * 60",
          "legendFormat": "{{vital_sign_type}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Share of readings out of range",
      "description": "Out-of-range readings divided by all accepted readings.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 20, "axisSoftMax": 0.5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(vitasignal_vital_readings_out_of_range_total[$__rate_interval])) or vector(0)) / sum(rate(vitasignal_vital_readings_registered_total[$__rate_interval]))",
          "legendFormat": "out of range"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Clinical alerts per minute by severity",
      "description": "Alerts raised per minute. Warning: outside the normal range. Critical: outside the critical range.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 30, "stacking": { "mode": "normal", "group": "A" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Critical" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "Warning" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (severity) (rate(vitasignal_alerts_raised_total[$__rate_interval])) * 60",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Rejected readings per minute by reason",
      "description": "Readings refused before being stored (unknown patient, invalid payload or physically implausible value).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 30, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (reason) (rate(vitasignal_vital_readings_rejected_total[$__rate_interval])) * 60",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Reading registration duration (p95)",
      "description": "Time spent inside the registration use case, including the database write.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, vital_sign_type) (rate(vitasignal_vital_readings_registration_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{vital_sign_type}}"
        }
      ]
    }
  ]
}
